          "type": "collapsible_row",
          "settings": {
            "heading": "Are delivery charges refundable?",
            "icon": "check_mark",
            "row_content": "<p>Unless the item(s) is found faulty, delivery charges are non-refundable. The return shipping cost will be deducted from the total amount of the refund.​For detailed information, please visit our page.<br/><br/></p>",
            "page": ""
          }
        },
